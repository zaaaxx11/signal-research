{
  "name": "signal-research-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Signal Research screener shell — dark-first React SPA served by FastAPI at /app",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.mjs",
    "audit:tokens": "node scripts/check-tokens.mjs --self-test",
    "check": "npm run test && npm run build && npm run audit:tokens && npm run budget",
    "vendor:shadcn": "node scripts/vendor-shadcn.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.65.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.3",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
