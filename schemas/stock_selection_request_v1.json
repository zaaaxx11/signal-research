{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ztockz.local/schemas/stock-selection-request-v1.json",
  "title": "StockSelectionRequestV1",
  "description": "A stock selection in one of two modes. `criteria` is a query over a region's universe: filters are ANDed, `sort` orders the matches and `limit` caps the page at 20 rows. `symbols` is an explicit ticker list resolved inside the universe addressed by `snapshot_id`. The response carries `total` (every row that matched) separately from `returned` (the page), so a 20-row display never claims to be a 20-stock market.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode"
  ],
  "properties": {
    "mode": {
      "enum": [
        "criteria",
        "symbols"
      ],
      "description": "Which question is being asked; the two modes share no knobs."
    },
    "region": {
      "enum": [
        "us",
        "global",
        "us_etf"
      ],
      "description": "Criteria only: the universe tab to query."
    },
    "asset_class": {
      "enum": [
        "stock",
        "etf"
      ],
      "default": "stock",
      "description": "Both modes: the instrument family. `stock` (default) and `etf` are different universes \u2014 `us_etf` implies `etf`, and `global` is stock-only. The ETF universe is `type=fund` + `subtype=etf` with no market-cap floor and the same OTC exclusion."
    },
    "view": {
      "enum": [
        "overview",
        "valuation",
        "ownership",
        "performance",
        "financial",
        "technical",
        "all"
      ],
      "description": "Both modes: shape every response row as one of the six Finviz views. A viewed row carries `rank`/`symbol`/`as_of` plus one cell per declared view column, filled from the parity metrics the bulk scan carries (missing columns stay null, never 0); without `view` the row is the light screen row."
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "description": "Criteria only: the query itself.",
      "properties": {
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "default": [],
          "description": "ANDed predicates; an empty list is the identity. A key with no light row column is refused with a 422 naming the missing metric \u2014 never ignored, because an ignored filter returns the unfiltered screen."
        },
        "sort": {
          "enum": [
            "market_cap",
            "turnover",
            "gainers"
          ],
          "default": "market_cap",
          "description": "The one visible metric the page is ordered by."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Page size. Clamped to 20: a larger value is not an error, it simply cannot widen the display, and the response reports the limit that was applied."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Zero-based row offset after filtering and sorting. The response still reports the full post-filter total, so 20-row pages can walk the whole universe."
        },
        "common_only": {
          "type": "boolean",
          "default": false,
          "description": "Display-only switch: keep the common-stock universe and leave preferred/warrant lines out of the page."
        }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Symbols only: tickers in the order the response should list them. A ticker the universe does not carry is reported in `missing`."
    },
    "source": {
      "enum": [
        "tradingview"
      ],
      "description": "Symbols only: the provenance the snapshot must declare. A source the snapshot was not built from is refused, never relabelled."
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "description": "Symbols only: the snapshot whose region and rule version the tickers are resolved against. It fixes *which* universe, not the prices \u2014 the rows are read fresh and dated by the response's `as_of`, never by the snapshot's."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "criteria"
          }
        }
      },
      "then": {
        "required": [
          "region",
          "criteria"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "symbols"
              ]
            },
            {
              "required": [
                "source"
              ]
            },
            {
              "required": [
                "snapshot_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "symbols"
          }
        }
      },
      "then": {
        "required": [
          "symbols",
          "source",
          "snapshot_id"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "region"
              ]
            },
            {
              "required": [
                "criteria"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "value"
      ],
      "oneOf": [
        {
          "required": [
            "key"
          ]
        },
        {
          "required": [
            "field"
          ]
        }
      ],
      "description": "One predicate: exactly one of `key` (a Finviz filter key, resolved to its row column) or `field` (the column itself), plus an operator and a value. A key whose entry in `x-filter-keys` carries `choice` takes `op: eq` and an option token as `value`.",
      "properties": {
        "key": {
          "type": "string",
          "description": "One of the 82 Finviz filter keys. The 47 that resolve to one row column, the 3 that filter through their option vocabulary, and the 32 that are refused with their reason, are listed in x-filter-keys."
        },
        "field": {
          "enum": [
            "atr_14",
            "aum_usd",
            "avg_volume_10d",
            "avg_volume_30d",
            "beta_1y",
            "change_from_open",
            "change_pct",
            "country",
            "currency",
            "current_ratio",
            "debt_to_equity",
            "dividend_yield",
            "earnings_date",
            "eps_forecast_next_fq",
            "eps_forecast_next_fy",
            "ev_ebitda",
            "ev_to_sales",
            "exchange",
            "float_shares",
            "gap_pct",
            "gross_margin",
            "high_52w",
            "industry",
            "insider_own",
            "inst_own",
            "is_primary",
            "listing_date",
            "low_52w",
            "market_cap_usd",
            "name",
            "oper_margin",
            "payout_ratio",
            "pb",
            "pct_from_52w_high",
            "pe_forward",
            "pe_ttm",
            "peg",
            "pfcf",
            "price",
            "price_to_cash",
            "profit_margin",
            "ps",
            "quick_ratio",
            "recom_finviz",
            "recommendation",
            "rel_volume_10d",
            "ret_10y",
            "ret_1m",
            "ret_1w",
            "ret_1y",
            "ret_3m",
            "ret_3y",
            "ret_5y",
            "ret_6m",
            "ret_ytd",
            "revenue_forecast_next_fy",
            "roa",
            "roe",
            "roic",
            "rsi_14",
            "sector",
            "shares_outstanding",
            "short_float",
            "sma_20",
            "sma_200",
            "sma_50",
            "symbol",
            "target_price",
            "turnover",
            "turnover_usd",
            "volatility_d",
            "volatility_m",
            "volatility_w",
            "volume"
          ],
          "description": "A canonical screen row column."
        },
        "op": {
          "enum": [
            "between",
            "contains",
            "eq",
            "gt",
            "gte",
            "in",
            "lt",
            "lte",
            "ne"
          ]
        },
        "value": {
          "description": "The comparison value. `in` and `between` take an array (`between` exactly two numbers); every other operator takes one scalar. For an option-driven key (ta_perf, ta_perf2, ta_volatility) the value is the Finviz option token itself (`1w10u`, `dup`, `wo2`), and the predicate each token compiles to is published under `x-filter-keys.<key>.choice.options`. Everywhere else Finviz's option tokens (`mega`, `u5`, `ob70`) are display buckets, not values: send the number the bucket means.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            }
          ]
        }
      }
    }
  },
