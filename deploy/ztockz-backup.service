[Unit]
Description=Ztockz snapshot backup (sha256 + rotation)
After=network.target

[Service]
Type=oneshot
User=ztockz
Group=ztockz
WorkingDirectory=/opt/ztockz
EnvironmentFile=/etc/ztockz/engine.env
ExecStart=/opt/ztockz/.venv/bin/python -m app.engine.ops backup --snapshot /var/lib/ztockz/engine-snapshot.json --extra /var/lib/ztockz/depth.json --dest /var/lib/ztockz/backups --keep 7
Nice=10
