[Unit]
Description=Ztockz snapshot backup (sha256 + rotation)
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ztockz
EnvironmentFile=/home/ubuntu/ztockz-data/engine.env
ExecStart=/home/ubuntu/ztockz/.venv/bin/python -m app.engine.ops backup --snapshot /home/ubuntu/ztockz-data/engine-snapshot.json --dest /home/ubuntu/ztockz-data/backups --keep 7
Nice=10
