[Unit]
Description=Ztockz cache retention (age + size, fund map protected)
After=network.target

[Service]
Type=oneshot
User=ztockz
Group=ztockz
WorkingDirectory=/opt/ztockz
EnvironmentFile=/etc/ztockz/engine.env
ExecStart=/opt/ztockz/.venv/bin/python -m app.engine.ops retention --cache-dir /var/lib/ztockz/cache --max-age-days 30 --max-bytes 2000000000
Nice=10
